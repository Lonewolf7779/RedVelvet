# Project Red Velvet - Environment Template
# Copy this file to .env.local for local execution
# NEVER COMMIT REAL SECRETS OR CREDENTIALS TO REPOSITORY

# Environment Mode: local, staging, production
ENVIRONMENT=local
PROJECT_NAME="Project Red Velvet API"

# Database Configuration (PostgreSQL with asyncpg)
POSTGRES_DB=redvelvet
POSTGRES_USER=redvelvet_user
POSTGRES_PASSWORD=redvelvet_dev_insecure_change_me
DATABASE_URL=postgresql+asyncpg://redvelvet_user:redvelvet_dev_insecure_change_me@localhost:5432/redvelvet

# Redis Cache Configuration
REDIS_PASSWORD=redvelvet_redis_dev_change_me
REDIS_URL=redis://:redvelvet_redis_dev_change_me@localhost:6379/0

# Security & CORS
# Strictly defined allowed origins, JSON array
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
LOG_LEVEL=INFO
MAX_REQUEST_SIZE_BYTES=10485760

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
